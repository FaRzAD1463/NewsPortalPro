@model NewsPortalPro.DTOs.UpdateVideoDto
@{
    ViewData["Title"] = "ভিডিও সম্পাদনা";
}

<h1 class="h4 mb-4">ভিডিও সম্পাদনা</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="row g-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-12">
        <label asp-for="Title" class="form-label">শিরোনাম</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label">বিবরণ (ঐচ্ছিক)</label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>

    <div class="col-md-8">
        <label asp-for="VideoUrl" class="form-label">ভিডিও লিংক (YouTube/Facebook)</label>
        <input asp-for="VideoUrl" class="form-control" />
        <span asp-validation-for="VideoUrl" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="Duration" class="form-label">দৈর্ঘ্য (ঐচ্ছিক)</label>
        <input asp-for="Duration" class="form-control" placeholder="যেমন: 5:32" />
    </div>

    <div class="col-md-8">
        <label asp-for="ThumbnailUrl" class="form-label">থাম্বনেইল ছবির লিংক (ঐচ্ছিক)</label>
        <input asp-for="ThumbnailUrl" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="NewsId" class="form-label">সংশ্লিষ্ট সংবাদ আইডি (ঐচ্ছিক)</label>
        <input asp-for="NewsId" class="form-control" type="number" />
    </div>

    <div class="col-12 form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label">সক্রিয় (প্রকাশিত)</label>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-danger">আপডেট করুন</button>
        <a asp-action="Index" class="btn btn-outline-secondary">বাতিল</a>
    </div>
</form>