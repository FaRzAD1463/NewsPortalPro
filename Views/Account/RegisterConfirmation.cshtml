@{
    ViewData["Title"] = "ইমেইল যাচাই করুন";
}

<div class="auth-page d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="auth-card card shadow-sm border-0 text-center" style="width:460px;max-width:95vw">
        <div class="card-body p-4 p-md-5">
            <i class="bi bi-envelope-check display-4 text-primary mb-3"></i>
            <h2 class="fw-bold">প্রায় সম্পন্ন!</h2>
            <p class="text-muted">
                আমরা <strong>@ViewBag.Email</strong> ঠিকানায় একটি যাচাইকরণ
                ইমেইল পাঠিয়েছি। লগইন করতে ইমেইলের লিংকে ক্লিক করুন।
            </p>
            <p class="text-muted small">
                ইমেইল না পেলে স্প্যাম ফোল্ডার দেখুন।
            </p>
            <a href="/Account/Login" class="btn btn-primary mt-2">লগইন পাতায় ফিরে যান</a>
        </div>
    </div>
</div>